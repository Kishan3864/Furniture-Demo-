{
  "name": "woodbook",
  "version": "1.0.0",
  "private": true,
  "description": "WoodBook - Furniture workshop management (Brighton Solution)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "deploy": "next build && firebase deploy --only hosting",
    "deploy:all": "next build && firebase deploy --only auth,firestore,hosting",
    "setup:admin": "node --env-file=.env.local --experimental-strip-types --no-warnings scripts/setup-admin.mts",
    "seed":"node --env-file=.env.local --experimental-strip-types scripts/seed.mts"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "firebase": "^11.10.0",
    "lucide-react": "^1.77.0",
    "next": "^15.5.29",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.7.0",
    "postcss": "^8.5.33",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3"
  }
}
