# Firebase project: furniture-webs
# Firebase Console > Project settings > General > Your apps > Web app > SDK config
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=furniture-webs.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=furniture-webs
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=furniture-webs.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Public URL of the deployed app (used in WhatsApp status links). Leave empty to use current domain.
NEXT_PUBLIC_APP_URL=https://furniture-webs.web.app

# Only for `npm run seed` (owner login used to write demo data)
SEED_EMAIL=
SEED_PASSWORD=

# Photo storage: firestore (default, free plan) | storage (needs Cloud Storage enabled)
NEXT_PUBLIC_PHOTO_STORE=firestore
